# Copia questo file in .env.local per lo sviluppo locale (npm run dev).
# In produzione (Vercel) queste variabili vanno impostate nel dashboard del progetto,
# Settings -> Environment Variables.

VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key

# Solo lato server (Vercel), MAI con prefisso VITE_ - altrimenti finirebbe nel
# bundle client. Usata da api/etf-price.js. Non serve in locale con `vite dev`
# a meno di eseguire anche `vercel dev`.
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key

# Solo lato server. Usata da api/calendar.ics.js per leggere le scadenze
# bypassando RLS (il feed lo legge Google Calendar, senza login Supabase).
# Si trova su Supabase: Project Settings -> API -> service_role secret key.
# Attenzione: bypassa tutte le policy RLS, non esporla mai al client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Solo lato server. Token segreto a piacere (es. generato con
# `openssl rand -hex 24`) che protegge /api/calendar.ics da accessi pubblici,
# dato che Google Calendar non puo' autenticarsi con Supabase Auth.
CALENDAR_FEED_TOKEN=your-random-secret-token
